# Copia este archivo como .env y rellénalo. ¡No compartas el .env ni lo subas a ningún sitio!
# Lleva el token del bot y la contraseña RCON.

# --- Discord ---
# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT
# ID del servidor de Discord (clic derecho en el servidor > Copiar ID). Con esto los comandos salen al instante
DISCORD_GUILD_ID=123456789012345678
# Canal de avisos y canal privado de registro de /comando, /dar y /admin. 0 = desactivado
DISCORD_CANAL_AVISOS=0
DISCORD_CANAL_REGISTRO=0
# Canal donde se avisa si el servidor se cae, se reinicia o vuelve a estar online (0 = el de avisos)
DISCORD_CANAL_ESTADO=0
# IDs de roles que pueden usar /admin, /comando, /actualizar y /diagnostico, separados por comas.
# Los administradores de Discord siempre pueden
DISCORD_ROLES_ADMIN=
# IDs de roles que pueden usar /dar (dar Pokémon, dinero y objetos), separados por comas
DISCORD_ROLES_REGALOS=

# --- RCON (la misma contraseña que rcon.password en server.properties) ---
# Con Docker: el nombre del contenedor del servidor (ej. cobbleverse-mc). Sin Docker: 127.0.0.1
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# --- Archivos del servidor ---
# Sin Docker: carpeta del servidor (donde están usercache.json y el mundo). En Windows usa / en vez de \
# (con Docker no hace falta: se usa MC_DATOS de abajo)
MC_CARPETA_SERVIDOR=/home/minecraft/servidor
# Carpeta del mundo dentro de la del servidor (level-name de server.properties)
MC_CARPETA_MUNDO=world

# --- Solo con Docker (docker-compose.yml) ---
# Carpeta "data" del servidor de Minecraft en esta máquina (se monta en solo lectura)
MC_DATOS=/home/usuario/cobbleverse/data
# Red de Docker del servidor (docker network ls). Con el compose del servidor en ~/cobbleverse: cobbleverse_default
RED_SERVIDOR=cobbleverse_default
# Usuario:grupo con el que corre el bot (el dueño de los archivos del servidor; `id -u`:`id -g`)
UID_GID=1000:1000

# --- Opcionales ---
# ACTUALIZAR_MINUTOS=5
# MONITOR_SEGUNDOS=30
# AVISAR_ENTRADAS=false
# MENSAJES_NOMBRE=CobbleBOT
# MENSAJES_COLOR=gold
